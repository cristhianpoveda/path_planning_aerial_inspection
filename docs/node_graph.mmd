---
config:
  layout: elk
---

flowchart LR

    %% DEFINE GOAL SOURCE
    GOALSRC["Goal source"]

    %% BRIDGE service
    subgraph BRIDGE["service: bridge"]
        DJI["dji_node"]
        DEC["camera_decoder"]
    end

    %% LOCALISATION service
    subgraph LOC["service: localisation"]
        SLAM["V-SLAM"]
        EKF["EKF (pose estimation + tf broadcast)"]
    end

    %% NAVIGATION service
    subgraph NAV["service: navigation"]
        TRAJ["trajectory_gen (stub)"]
        WPF["waypoint_follower"]
        PC["position_controller"]
    end

    %% EVALUATION service (dev-only)
    subgraph EVAL["service: evaluation"]
        DB["ros_domains_bridge (0 -> 12)"]
        CMP["comparison_node"]
    end

    %% Just to show the relation to my nodes
    TF([" /tf · /tf_static "])

    %% --- perception ---
    DEC -->|"/camera/image_raw<br/>sensor_msgs/Image"| SLAM

    %% --- telemetry into EKF (stamped with measurement time) ---
    DJI -->|"/telemetry/velocity<br/>geometry_msgs/Vector3"| EKF
    DJI -->|"/telemetry/altitude_agl<br/>std_msgs/Float64"| EKF

    %% --- localisation internal + output ---
    SLAM -->|"/vo/odom (no-scale)<br/>nav_msgs/Odometry"| EKF
    EKF -->|"/localisation/pose<br/>geometry_msgs/PoseWithCovarianceStamped"| PC

    %% --- navigation chain ---
    GOALSRC -->|"/goal<br/>to define!!"| TRAJ
    TRAJ -->|"/plan/path<br/>nav_msgs/Path"| WPF
    WPF -->|"/setpoint<br/>geometry_msgs/PoseStamped"| PC
    PC -->|"command/stick<br/>std_msgs/Float64MultiArray"| DJI

    %% --- evaluation (dev-only) ---
    EKF -->|"/localisation/pose<br/>geometry_msgs/PoseWithCovarianceStamped"| CMP
    DB -->|"/rigid_bodies/dji_mini4 (domain 12)<br/>geometry_msgs/PoseStamped"| CMP

    %% --- tf publications (broadcast bus) ---
    DEC -->|"/tf_static (cam&harr;body)<br/>geometry_msgs/TransformStamped"| TF
    EKF -->|"/tf (map&rarr;odom&rarr;base_link)<br/>tf2_msgs/TFMessage"| TF

    %% /telemetry/satellite_count if switches indoor and outdoor

    style BRIDGE fill:#efe,stroke:#474,color:#222
    style LOC fill:#eef,stroke:#447,color:#222
    style NAV fill:#fef,stroke:#747,color:#222
    style EVAL fill:#ffe,stroke:#774,color:#222,stroke-dasharray:4 3
    style GOALSRC fill:#f7f7f7,stroke:#999,color:#222,stroke-dasharray:4 3
    style TF fill:#fff,stroke:#333,color:#222